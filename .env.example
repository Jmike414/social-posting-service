# ─────────────────────────────────────────────────────────────────────────────
# social-posting-service — environment
# Copy to .env for local dev. In production (Render) set these in the dashboard.
# NEVER commit a real .env. The Buffer key and console password are secrets.
# ─────────────────────────────────────────────────────────────────────────────

# --- HTTP server ---
PORT=4000
# Publicly reachable base URL of THIS service. Buffer fetches uploaded images by
# URL, so image posting requires this to be reachable by Buffer (i.e. a real
# https host on deploy — localhost will NOT work for image posts).
PUBLIC_BASE_URL=http://localhost:4000

# --- Console + endpoint auth ---
# Operator login password for the mobile console (required).
CONSOLE_PASSWORD=change-me
# Optional second login for a Spanish-copy reviewer (CrewMando). Leave unset to disable.
CONSOLE_PASSWORD_ES=
# Random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=dev-only-insecure-secret-change-me
# Shared secret required on the programmatic POST /enqueue endpoint (X-Service-Token).
# Leave unset to disable the HTTP enqueue surface entirely (console still works).
SERVICE_TOKEN=

# --- Buffer GraphQL API ---
# Personal API key from Buffer: Settings -> API -> Create a new API key.
BUFFER_API_KEY=
# Endpoint (override only if Buffer changes it).
BUFFER_API_URL=https://api.buffer.com
# Optional: pin the organization id. If unset, setup-channels discovers it.
BUFFER_ORGANIZATION_ID=

# --- Drafter (Anthropic) ---
# If unset, the drafter falls back to a deterministic heuristic formatter so the
# service still runs end-to-end without an AI key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Datastore ---
# Default: local SQLite file (good for dev + single-instance deploy).
SQLITE_PATH=./data/social.db
# Deploy target alternative: a Postgres SEPARATE from the engine. If set, the
# service uses Postgres instead of SQLite. (Not required to run locally.)
# DATABASE_URL=postgres://user:pass@host:5432/social_posting
